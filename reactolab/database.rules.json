{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.child('role').val() === 'student' && newData.child('status').val() === 'active') || (data.exists() && data.child('role').val() === newData.child('role').val() && data.child('status').val() === newData.child('status').val()))"
      }
    },

    "classes": {
      ".read": "auth != null",
      ".indexOn": ["teacherId"],
      "$classId": {
        ".write": "auth != null && ((!data.exists() && newData.child('teacherId').val() === auth.uid && root.child('users').child(auth.uid).child('role').val() === 'teacher') || (data.exists() && data.child('teacherId').val() === auth.uid))"
      }
    },

    "classCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher' && ((newData.exists() && root.child('classes').child(newData.child('classId').val()).child('teacherId').val() === auth.uid) || (!newData.exists() && data.exists() && root.child('classes').child(data.child('classId').val()).child('teacherId').val() === auth.uid))"
      }
    },

    "classMemberships": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('role').val() === 'student' && root.child('classes').child($classId).child('status').val() === 'active'"
        }
      }
    },

    "progress": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('classMemberships').child($classId).child(auth.uid).exists()"
        }
      }
    },

    "responses": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('classMemberships').child($classId).child(auth.uid).exists()"
        }
      }
    },

    "experimentData": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('classMemberships').child($classId).child(auth.uid).exists()"
        }
      }
    },

    "lkpdSnapshots": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('classMemberships').child($classId).child(auth.uid).exists()"
        }
      }
    },

    "discussionProgress": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('classMemberships').child($classId).child(auth.uid).exists()"
        }
      }
    },

    "discussionCases": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('classMemberships').child($classId).child(auth.uid).exists() && query.orderByChild == 'published' && query.equalTo == true))",
        ".indexOn": ["published"],
        ".write": "auth != null && root.child('classes').child($classId).child('teacherId').val() === auth.uid"
      }
    },

    "publishedDiscussionCases": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('classMemberships').child($classId).child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('classes').child($classId).child('teacherId').val() === auth.uid"
      }
    },

    "forumPosts": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$caseId": {
          ".read": "auth != null && root.child('classMemberships').child($classId).child(auth.uid).exists() && (data.child(auth.uid).exists() || root.child('forumArguments').child($classId).child($caseId).child(auth.uid).exists() || root.child('forumArgumentAttempts').child($classId).child($caseId).child(auth.uid).exists())",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('classMemberships').child($classId).child(auth.uid).exists() && newData.child('claim').isString() && newData.child('evidence').isString() && newData.child('reasoning').isString()"
          }
        }
      }
    },

    "forumArguments": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$caseId": {
          ".read": "auth != null && root.child('classMemberships').child($classId).child(auth.uid).exists() && (data.child(auth.uid).exists() || root.child('forumPosts').child($classId).child($caseId).child(auth.uid).exists() || root.child('forumArgumentAttempts').child($classId).child($caseId).child(auth.uid).exists())",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('classMemberships').child($classId).child(auth.uid).exists() && root.child('discussionCases').child($classId).child($caseId).child('published').val() === true && !root.child('discussionCases').child($classId).child($caseId).child('archivedAt').exists()",
            ".validate": "newData.hasChildren(['format', 'verdict', 'argument', 'studentName', 'submittedAt']) && newData.child('format').val() === 'hypothesis_argument' && (newData.child('verdict').val() === 'supported' || newData.child('verdict').val() === 'not_supported') && newData.child('argument').isString() && newData.child('studentName').isString() && newData.child('submittedAt').isNumber() && !newData.child('hypothesis').exists() && !newData.child('problemQuestion').exists() && !newData.child('evidenceSummary').exists() && !newData.child('evidenceRefs').exists()"
          }
        }
      }
    },

    "forumArgumentAttempts": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$caseId": {
          ".read": "auth != null && root.child('classMemberships').child($classId).child(auth.uid).exists() && (data.child(auth.uid).exists() || root.child('forumArguments').child($classId).child($caseId).child(auth.uid).exists() || root.child('forumPosts').child($classId).child($caseId).child(auth.uid).exists())",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$attemptId": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('classMemberships').child($classId).child(auth.uid).exists() && root.child('progress').child($classId).child(auth.uid).child('modules').child('5').child('attemptId').val() === $attemptId && root.child('discussionCases').child($classId).child($caseId).child('published').val() === true && !root.child('discussionCases').child($classId).child($caseId).child('archivedAt').exists()",
              ".validate": "newData.hasChildren(['format', 'attemptId', 'verdict', 'argument', 'studentName', 'submittedAt']) && newData.child('format').val() === 'hypothesis_argument' && newData.child('attemptId').val() === $attemptId && (newData.child('verdict').val() === 'supported' || newData.child('verdict').val() === 'not_supported') && newData.child('argument').isString() && newData.child('studentName').isString() && newData.child('submittedAt').isNumber()"
            }
          }
        }
      }
    },

    "forumComments": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$caseId": {
          ".read": "auth != null && root.child('classMemberships').child($classId).child(auth.uid).exists() && (root.child('forumPosts').child($classId).child($caseId).child(auth.uid).exists() || root.child('forumArguments').child($classId).child($caseId).child(auth.uid).exists() || root.child('forumArgumentAttempts').child($classId).child($caseId).child(auth.uid).exists())",
          "$commentId": {
            ".write": "auth != null && !data.exists() && newData.child('authorId').val() === auth.uid && root.child('classMemberships').child($classId).child(auth.uid).exists() && (root.child('forumPosts').child($classId).child($caseId).child(auth.uid).exists() || root.child('forumArguments').child($classId).child($caseId).child(auth.uid).exists()) && (!newData.child('targetStudentId').exists() || (newData.child('targetStudentId').val() !== auth.uid && (root.child('forumPosts').child($classId).child($caseId).child(newData.child('targetStudentId').val()).exists() || root.child('forumArguments').child($classId).child($caseId).child(newData.child('targetStudentId').val()).exists())))"
          }
        }
      }
    },

    "forumPeerReviews": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$caseId": {
          "$reviewerId": {
            ".read": "auth != null && auth.uid === $reviewerId",
            "$targetId": {
              ".write": "auth != null && auth.uid === $reviewerId && $targetId !== $reviewerId && !data.exists() && root.child('classMemberships').child($classId).child(auth.uid).exists() && (root.child('forumPosts').child($classId).child($caseId).child($reviewerId).exists() || root.child('forumArguments').child($classId).child($caseId).child($reviewerId).exists()) && (root.child('forumPosts').child($classId).child($caseId).child($targetId).exists() || root.child('forumArguments').child($classId).child($caseId).child($targetId).exists())",
              ".validate": "newData.hasChildren(['reviewerId', 'reviewerName', 'targetStudentId', 'targetName', 'differenceReason', 'response', 'createdAt']) && newData.child('reviewerId').val() === $reviewerId && newData.child('targetStudentId').val() === $targetId && newData.child('reviewerName').isString() && newData.child('targetName').isString() && newData.child('differenceReason').isString() && newData.child('response').isString() && newData.child('createdAt').isNumber()"
            }
          }
        }
      }
    },

    "forumPeerReviewAttempts": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$caseId": {
          "$reviewerId": {
            ".read": "auth != null && auth.uid === $reviewerId",
            "$attemptId": {
              "$targetId": {
                ".write": "auth != null && auth.uid === $reviewerId && $targetId !== $reviewerId && !data.exists() && root.child('classMemberships').child($classId).child(auth.uid).exists() && root.child('progress').child($classId).child(auth.uid).child('modules').child('5').child('attemptId').val() === $attemptId && root.child('forumArgumentAttempts').child($classId).child($caseId).child($reviewerId).child($attemptId).exists() && (root.child('forumArgumentAttempts').child($classId).child($caseId).child($targetId).exists() || root.child('forumArguments').child($classId).child($caseId).child($targetId).exists() || root.child('forumPosts').child($classId).child($caseId).child($targetId).exists()) && (!newData.child('targetAttemptId').exists() || root.child('forumArgumentAttempts').child($classId).child($caseId).child($targetId).child(newData.child('targetAttemptId').val()).exists())",
                ".validate": "newData.hasChildren(['reviewerId', 'reviewerName', 'attemptId', 'targetStudentId', 'targetName', 'differenceReason', 'response', 'createdAt']) && newData.child('reviewerId').val() === $reviewerId && newData.child('attemptId').val() === $attemptId && newData.child('targetStudentId').val() === $targetId && newData.child('reviewerName').isString() && newData.child('targetName').isString() && (!newData.child('targetAttemptId').exists() || newData.child('targetAttemptId').isString()) && newData.child('differenceReason').isString() && newData.child('response').isString() && newData.child('createdAt').isNumber()"
              }
            }
          }
        }
      }
    },

    "teacherConclusions": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('classMemberships').child($classId).child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('classes').child($classId).child('teacherId').val() === auth.uid"
      }
    },

    "grades": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('classes').child($classId).child('teacherId').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },

    "practiceConfigs": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('classMemberships').child($classId).child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('classes').child($classId).child('teacherId').val() === auth.uid",
        ".validate": "newData.hasChildren(['enabled', 'mode', 'updatedAt']) && newData.child('enabled').isBoolean() && (newData.child('mode').val() === 'default' || newData.child('mode').val() === 'custom') && newData.child('updatedAt').isNumber()"
      }
    },

    "scaffoldConfigs": {
      ".read": "auth != null",
      ".write": false
    },

    "scaffoldSettings": {
      "$classId": {
        ".read": "auth != null && (root.child('classes').child($classId).child('teacherId').val() === auth.uid || root.child('classMemberships').child($classId).child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('classes').child($classId).child('teacherId').val() === auth.uid",
        ".validate": "newData.hasChildren(['enabled', 'updatedAt']) && newData.child('enabled').isBoolean() && newData.child('updatedAt').isNumber()"
      }
    },

    "passwordResetRequests": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$reqId": {
        ".write": "(!data.exists() && newData.child('status').val() === 'pending' && newData.child('email').isString() && newData.child('createdAt').isNumber()) || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "auditLogs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    }
  }
}
